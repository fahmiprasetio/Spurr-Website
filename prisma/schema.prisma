generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CarStatus {
  AVAILABLE
  BOOKED
  MAINTENANCE
  INACTIVE
}

enum UserRole {
  USER
  ADMIN
}

enum RentalStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  BANK_TRANSFER
  E_WALLET
  CREDIT_CARD
  VIRTUAL_ACCOUNT
}

enum NotificationType {
  RENTAL_CREATED
  PAYMENT_RECEIVED
  RENTAL_STATUS_CHANGED
  GENERAL_UPDATE
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

model Brand {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  country   String?
  founded   Int?
  logo      String?
  cars      Car[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Car {
  id             String    @id
  name           String
  year           Int
  power          String
  topSpeed       String
  acceleration   String
  description    String
  color          String
  bgGradient     String
  baseImage      String?
  sequenceFolder String?
  sequenceCount  Int?
  sequencePrefix String?
  sequenceExt    String?
  status         CarStatus @default(AVAILABLE)
  brandId        Int
  brand          Brand     @relation(fields: [brandId], references: [id], onDelete: Restrict)
  rentals        Rental[]
  reviews        CarReview[]
  wishlistItems  WishlistItem[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([brandId])
  @@index([status])
}

model User {
  id           String    @id @default(cuid())
  name         String?
  profileImage String?
  email        String    @unique
  passwordHash String
  role         UserRole  @default(USER)
  sessions     Session[]
  rentals      Rental[]
  payments     Payment[]
  reviews      CarReview[]
  wishlistItems WishlistItem[]
  notifications EmailNotification[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model CarReview {
  id        String   @id @default(cuid())
  sourceKey String?  @unique
  carId     String
  userId    String
  content   String   @db.Text
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([carId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  carId     String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, carId])
  @@index([userId])
  @@index([carId])
}

model Rental {
  id         String       @id @default(cuid())
  userId     String
  carId      String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  car        Car          @relation(fields: [carId], references: [id], onDelete: Restrict)
  startDate  DateTime
  endDate    DateTime
  totalDays  Int
  totalAmount Int
  status     RentalStatus @default(PENDING)
  notes      String?
  payment    Payment?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([userId])
  @@index([carId])
  @@index([status])
}

model Payment {
  id             String        @id @default(cuid())
  rentalId       String        @unique
  userId         String
  rental         Rental        @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount         Int
  method         PaymentMethod @default(BANK_TRANSFER)
  status         PaymentStatus @default(PENDING)
  transactionRef String        @unique
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
  @@index([status])
}

model EmailNotification {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  subject   String
  message   String
  status    NotificationStatus @default(QUEUED)
  sentAt    DateTime?
  metadata  Json?
  createdAt DateTime           @default(now())

  @@index([userId])
  @@index([status])
  @@index([type])
}
